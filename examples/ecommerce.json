    { "id": "server-1", "type": "server", "position": { "x": 1380, "y": 60 },
      "config": { "capacity": 8, "processingMs": 60, "queueSize": 20, "failureRate": 0.01, "jitterMs": 30, "warmupMs": 0, "down": false } },
    { "id": "server-2", "type": "server", "position": { "x": 1380, "y": 180 },
