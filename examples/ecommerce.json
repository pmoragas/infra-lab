    { "id": "circuitBreaker-1", "type": "circuitBreaker", "position": { "x": 1380, "y": 420 },
      "config": { "failureThreshold": 5, "windowMs": 10000, "openMs": 5000 } },
    { "id": "queue-1", "type": "queue", "position": { "x": 1380, "y": 540 }, "config": { "maxSize": 50 } },

