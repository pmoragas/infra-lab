{
  "id": "lesson-health-check",
  "name": "1. Dead server",
  "settings": { "seed": 1, "speed": 1 },
  "guide": {
    "question": "One of three servers is dead. Does the load balancer notice?",
    "steps": [
      "Press ⏩ 60 s. The Packets panel opens: about a third of requests failed with a timeout, because the load balancer keeps sending them to server-2.",
      "Select the Load Balancer and turn on Health check.",
      "Press ⏩ 60 s again. A second column appears for just that minute: success is back to about 100%, because the load balancer now skips the dead server. (A few requests already in flight still fail.)",
      "Bonus: turn Health check off, set Retries to 1 and press ⏩ 60 s. Requests succeed again, but the ones that tried server-2 first waited a full second: compare p95 across the columns."
    ]
  },
  "nodes": [
    { "id": "world-1", "type": "world", "position": { "x": 40, "y": 200 },
      "config": { "name": "Users", "rps": 10, "pattern": "steady", "clients": 50, "keyspace": 100, "timeoutMs": 5000 } },
